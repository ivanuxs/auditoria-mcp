# Plantilla de configuración del MCP de auditoría.
#   cp .env.example .env && chmod 600 .env
# El `.env` no se versiona y ningún valor suyo debe imprimirse ni registrarse.

# Puerto del servidor MCP. Escucha SOLO en 127.0.0.1.
MCP_INTERNO_PUERTO=8940

# Puerto del proxy con token. Escucha en 0.0.0.0 (lo alcanza nginx de oficina-2).
MCP_PROXY_PUERTO=8941

# Token que deben enviar los clientes:  Authorization: Bearer <token>
# Generarlo con:  openssl rand -hex 32
MCP_TOKEN=

# Token exclusivo para Nodit Agent PayGate (opcional). Mientras esté, también vale.
MCP_TOKEN_NODIT=

# Dominio público del servicio.
MCP_DOMINIO=auditoria.hlquantlabs.trade

# Datos para el alta en Nodit Agent PayGate (no los usa el proxy).
X402_PRECIO_USD=
X402_RED=base

# Para la futura herramienta de captura: MCP navegador.
NAVEGADOR_URL=http://127.0.0.1:8931/mcp
NAVEGADOR_TOKEN=
